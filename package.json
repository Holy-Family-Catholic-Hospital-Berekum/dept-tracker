{
  "name": "dept-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "npx -y firebase-tools@15 emulators:start --only auth,firestore",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --only firestore --project demo-dept-tracker \"vitest run\"",
    "deploy:rules": "npx -y firebase-tools@15 deploy --only firestore:rules",
    "deploy": "vite build && npx -y firebase-tools@15 deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "firebase": "^13.0.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.3"
  }
}
